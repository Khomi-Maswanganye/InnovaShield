<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>InnovaShield – Sign In</title>
  <link rel="stylesheet" href="/style.css"/>
  <script>(function(){ document.documentElement.setAttribute('data-theme', localStorage.getItem('theme')||'dark'); })();</script>
  <style>
    .auth-wrap {
      min-height: 100vh; display: flex; align-items: center;
      justify-content: center; padding: 2rem;
    }
    .auth-outer {
      width: 100%; max-width: 480px;
      animation: heroFadeUp 0.6s ease-out both;
    }

    /* ── logo ── */
    .auth-logo {
      display: flex; align-items: center; gap: 0.65rem;
      justify-content: center; margin-bottom: 2rem;
    }
    .auth-logo-mark {
      width: 38px; height: 38px; border-radius: 10px;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 0 20px rgba(79,140,247,0.4);
    }
    .auth-logo-mark svg { width: 20px; height: 20px; fill: #fff; }
    .auth-logo-text {
      font-family: 'Syne', sans-serif; font-weight: 800;
      font-size: 1.25rem; letter-spacing: -0.02em; color: var(--text);
    }
    .auth-logo-text span { color: var(--accent); }

    /* ── card ── */
    .auth-card {
      background: var(--card); border: 1px solid var(--border-2);
      border-radius: 22px; padding: 2.5rem 2.5rem 2rem;
      box-shadow: 0 24px 60px rgba(0,0,0,0.35);
      position: relative; overflow: hidden;
    }
    .auth-card::before {
      content: ''; position: absolute; top: -60px; left: -60px;
      width: 220px; height: 220px; border-radius: 50%;
      background: radial-gradient(circle, rgba(34,211,238,0.08), transparent 70%);
      pointer-events: none;
    }
    .auth-card::after {
      content: ''; position: absolute; bottom: -60px; right: -60px;
      width: 180px; height: 180px; border-radius: 50%;
      background: radial-gradient(circle, rgba(79,140,247,0.08), transparent 70%);
      pointer-events: none;
    }

    /* ── header ── */
    .auth-header { margin-bottom: 2rem; }
    .auth-eyebrow {
      font-family: 'DM Mono', monospace; font-size: 0.7rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent2);
      margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem;
    }
    .auth-eyebrow::before {
      content: ''; width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent2); display: inline-block;
    }
    .auth-header h1 {
      font-size: 1.9rem; font-weight: 800; letter-spacing: -0.03em;
      color: var(--text); margin-bottom: 0.4rem; line-height: 1.15;
    }
    .auth-header p {
      font-size: 0.88rem; color: var(--text-2); line-height: 1.6; margin: 0;
    }

    /* ── errors ── */
    .auth-errors {
      background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.25);
      border-radius: 12px; padding: 0.85rem 1rem; margin-bottom: 1.5rem;
      display: flex; flex-direction: column; gap: 0.25rem;
    }
    .auth-errors p {
      color: var(--danger); font-size: 0.85rem; margin: 0;
      display: flex; align-items: center; gap: 0.4rem;
    }

    /* ── form ── */
    .auth-form .form-group { margin-bottom: 1.25rem; }
    .auth-form .form-group label {
      display: block; font-size: 0.82rem; font-weight: 600;
      color: var(--text-2); margin-bottom: 0.45rem; letter-spacing: 0.01em;
    }
    .auth-form .form-group .input-wrap {
      position: relative;
    }
    .auth-form .form-group .input-icon {
      position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%);
      color: var(--muted); pointer-events: none;
    }
    .auth-form .form-group input {
      width: 100%; padding: 0.75rem 1rem 0.75rem 2.5rem;
      background: var(--surface); border: 1px solid var(--border-2);
      border-radius: 10px; color: var(--text);
      font-family: 'DM Sans', sans-serif; font-size: 0.93rem;
      outline: none; transition: border-color 0.2s, box-shadow 0.2s;
      box-sizing: border-box;
    }
    .auth-form .form-group input::placeholder { color: var(--muted); }
    .auth-form .form-group input:focus {
      border-color: var(--accent2);
      box-shadow: 0 0 0 3px rgba(34,211,238,0.1);
    }

    /* ── divider ── */
    .auth-divider {
      display: flex; align-items: center; gap: 0.75rem; margin: 1.5rem 0;
    }
    .auth-divider-line { flex: 1; height: 1px; background: var(--border); }
    .auth-divider-text { font-size: 0.75rem; color: var(--muted); white-space: nowrap; }

    /* ── submit ── */
    .auth-btn {
      width: 100%; padding: 0.85rem;
      background: linear-gradient(135deg, var(--accent2), var(--accent));
      color: #fff; border: none; border-radius: 12px;
      font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700;
      cursor: pointer; letter-spacing: 0.01em;
      transition: opacity 0.2s, transform 0.2s;
      box-shadow: 0 4px 20px rgba(34,211,238,0.25);
    }
    .auth-btn:hover { opacity: 0.88; transform: translateY(-1px); }

    /* ── contact hint ── */
    .auth-contact {
      margin-top: 1.25rem; padding: 0.85rem 1rem;
      background: rgba(34,211,238,0.05); border: 1px solid rgba(34,211,238,0.15);
      border-radius: 10px; font-size: 0.8rem; color: var(--text-2);
      display: flex; align-items: center; gap: 0.5rem;
    }
    .auth-contact svg { flex-shrink: 0; color: var(--accent2); }
    .auth-contact strong { color: var(--accent2); }

    /* ── footer ── */
    .auth-footer {
      text-align: center; margin-top: 1.5rem;
      display: flex; flex-direction: column; gap: 0.6rem;
    }
    .auth-footer a {
      font-size: 0.84rem; color: var(--text-2); font-weight: 500;
      display: inline-flex; align-items: center; gap: 0.35rem;
      transition: color 0.2s;
    }
    .auth-footer a:hover { color: var(--accent); }
    .auth-footer .register-link {
      font-size: 0.88rem; color: var(--muted);
    }
    .auth-footer .register-link a {
      color: var(--accent); font-weight: 700; font-size: 0.88rem;
    }

    @media (max-width: 520px) {
      .auth-card { padding: 1.75rem 1.25rem; }
    }
  </style>
</head>
<body>
<div class="page-bg"></div>
<div class="auth-wrap">
  <div class="auth-outer">

    <!-- logo -->
    <div class="auth-logo">
      <div class="auth-logo-mark">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L3 7l9 5 9-5-9-5z"/>
          <path d="M3 17l9 5 9-5"/>
          <path d="M3 12l9 5 9-5"/>
        </svg>
      </div>
      <div class="auth-logo-text">Innova<span>Shield</span></div>
    </div>

    <!-- card -->
    <div class="auth-card">

      <!-- header -->
      <div class="auth-header">
        <div class="auth-eyebrow">Welcome Back</div>
        <h1>Sign in to your account</h1>
        <p>Monitor patents, track trademarks and get AI-powered IP insights.</p>
      </div>

      <!-- errors -->
      <% if (errors && errors.length) { %>
      <div class="auth-errors">
        <% errors.forEach(e => { %>
        <p>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <%= e %>
        </p>
        <% }) %>
      </div>
      <% } %>

      <!-- form -->
      <form action="/login" method="POST" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
        <input type="hidden" name="next" value="<%= next %>"/>

        <div class="form-group">
          <label>Username or Email</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </span>
            <input type="text" name="username"
              autocomplete="username"
              required
              placeholder="Enter your username or email"/>
          </div>
        </div>

        <div class="form-group">
          <label>Password</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </span>
            <input type="password" name="password"
              autocomplete="current-password"
              required
              placeholder="Enter your password"/>
          </div>
        </div>

        <button type="submit" class="auth-btn">Sign In →</button>
      </form>

      <!-- contact hint -->
      <div class="auth-contact">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        Forgot your credentials? Contact your administrator at
        <strong>admin@innovashield.com</strong>
      </div>

      <!-- footer -->
      <div class="auth-footer">
        <a href="javascript:history.back()">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          Go back
        </a>
        <div class="auth-divider">
          <div class="auth-divider-line"></div>
          <span class="auth-divider-text">don't have an account?</span>
          <div class="auth-divider-line"></div>
        </div>
        <div class="register-link">
          <a href="/register">✨ Create a free account</a>
        </div>
      </div>

    </div>
  </div>
</div>
</body>
</html>